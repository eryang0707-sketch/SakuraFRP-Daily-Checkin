# 智谱AI API配置
# 请前往 https://open.bigmodel.cn/ 注册并获取API Key
# 免费模型无需付费即可使用
ZHIPU_API_KEY=your_api_key_here

# 视觉识别模型（用于识别验证码图片）
ZHIPU_MODEL_VISION=glm-4.6v-flash

# 文本模型（用于语义匹配）
ZHIPU_MODEL_TEXT=glm-4.7-flash

# AI 调用失败重试次数（网络抖动/限流时生效）
AI_CALL_MAX_RETRIES=2

# 逐格识别并发数（建议 2-4，过高易触发限流）
AI_CELL_WORKERS=3

# 定时执行时间（格式：HH:MM，如 08:00）
# 脚本会在指定时间±30分钟内随机选择一个秒级时间点执行
# 例如：设置为 08:00，则会在 07:30:00 到 08:30:00 之间随机执行
SCHEDULE_TIME=08:00

# HTTP代理配置（可选）
# 如果服务器需要代理才能访问目标网站，请配置此项
# 例如：HTTP_PROXY=http://127.0.0.1:7890
# 留空表示不使用代理
HTTP_PROXY=

# 是否复用 state.json 登录态缓存
# 建议关闭（false），避免历史会话导致账号/流量状态误判
USE_STATE_CACHE=false

# 验证码额外重试轮配置（可选）
# 当验证码场景基础尝试失败后，是否再追加一轮尝试
CAPTCHA_EXTRA_ROUND_ENABLED=true
# 额外轮追加的尝试次数（建议 1-3）
CAPTCHA_EXTRA_ROUND_ATTEMPTS=2

# ===== 邮件通知 =====
# 总开关
EMAIL_NOTIFY_ENABLED=true
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_TO=

# 通知策略（控制"每天都收到邮件"的问题）
#   none         = 从不发邮件
#   failure_only = 仅最终失败时发（默认，推荐）
#   change       = 最终失败 + 当天首次签到成功；"今日已签到"不发
#   all          = 每次运行都发（旧行为）
EMAIL_NOTIFY_POLICY=failure_only

# 连续失败告警邮件（与失败邮件内容重复，默认关闭避免一次失败收两封）
FAIL_ALERT_ENABLED=false
FAIL_ALERT_THRESHOLD=2

# 外层脚本级重试次数（每轮完整执行一次 main.py）
CHECKIN_MAX_RETRIES=5

# 外层脚本级重试间隔（秒）
CHECKIN_RETRY_INTERVAL_SECONDS=30

